{
  "name": "react-hardcover-shelf",
  "version": "0.0.1",
  "private": false,
  "description": "A React widget for displaying a Hardcover bookshelf",
  "license": "MIT",
  "author": "Kyle Karpack <kylekarpack+rhs@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylekarpack/react-hardcover-shelf.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test --reporter=verbose",
    "test:related": "vp test related",
    "dev": "vp dev",
    "build": "vp pack",
    "preview": "vp preview",
    "prepublishOnly": "pnpm build",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build -o docs-build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint:check": "vp lint",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "clean": "rm -rf dist",
    "release": "release-it",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "release-it": "^21.1.2",
    "storybook": "^10.6.5",
    "typescript": "7.0.2",
    "typescript-plugin-css-modules": "^4.2.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "release-it": {
    "github": {
      "release": true,
      "web": true
    },
    "hooks": {
      "before:init": [
        "pnpm check",
        "pnpm test"
      ],
      "after:bump": "pnpm build"
    }
  }
}
