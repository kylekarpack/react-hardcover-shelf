{
  "name": "react-hardcover-shelf",
  "version": "0.0.1",
  "private": false,
  "description": "A React widget for displaying a Hardcover bookshelf",
  "license": "MIT",
  "author": "Kyle Karpack <kylekarpack+rhs@gmail.com>",
  "repository": "https://github.com/kylekarpack/react-hardcover-shelf",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.umd.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --reporter=verbose",
    "test:related": "vitest related",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublish": "pnpm build",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build -o docs-build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "fix": "oxfmt --write . && oxlint --fix",
    "clean": "rm -rf dist",
    "compile": "tsc",
    "release": "release-it"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "release-it": "^21.1.2",
    "storybook": "^10.6.5",
    "storybook-dark-mode": "^5.0.0",
    "typescript": "6.0.3",
    "typescript-plugin-css-modules": "^4.2.2",
    "vite": "^8.3.5",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26"
  },
  "engineStrict": true,
  "release-it": {
    "github": {
      "release": true,
      "web": true
    },
    "hooks": {
      "before:init": [
        "npm run test"
      ],
      "after:bump": "npm run build"
    }
  }
}
